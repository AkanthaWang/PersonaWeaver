# Optional local backend environment variables.
# Export these in your shell before starting uvicorn.
# The local application does not automatically read .env.
# Defaults are resolved relative to the repository, not the current directory.

# PERSONAWEAVER_DATA_DIR=D:/Person/PersonaWeaver/data
# PERSONAWEAVER_DB_PATH=D:/Person/PersonaWeaver/data/personaweaver.sqlite3
# Batch upload limits (bytes and file count).
# PERSONAWEAVER_MAX_BATCH_FILES=20
# PERSONAWEAVER_MAX_BATCH_UPLOAD_BYTES=104857600

# Configure model provider, URL, model and API key in the application's Settings.
# For an OpenAI Responses-compatible endpoint use the /v1 base URL and set:
# ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
# ECNU_API_PROTOCOL=responses
# ECNU_MODEL_NAME=ecnu-max
# ECNU_API_KEY=<your-key>
# Legacy cloud settings are archived in backend/legacy.env.example.
