# CharPick environment example
# Copy this file to .env and fill real values locally.
# Never commit .env or any real secret to GitHub.

# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase PostgreSQL connection
# Prefer transaction pooler for cloud/team usage.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Optional direct connection or session pooler fallback
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_POOLER_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_PROJECT_REF=<your-project-ref>
SUPABASE_DB_PASSWORD=<your-db-password>

# Supabase HTTP API / Auth / Storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=<your-storage-bucket>

# Aliyun OSS
OSS_ENDPOINT=<your-oss-endpoint>
OSS_BUCKET=<your-oss-bucket>
OSS_BUCKET_HOST=<your-oss-public-host>
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>

# LLM provider selection
# Current main route: vivo AIGC provider. Campus API remains the fallback provider.
LLM_PROVIDER=vivo
LLM_MODEL=Volc-DeepSeek-V3.2
LLM_FALLBACK_PROVIDERS=remote_api

# Campus remote API
ECNU_API_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
ECNU_API_KEY=<your-ecnu-api-key>
ECNU_MODEL_NAME=ecnu-max

# vivo AIGC API
VIVO_AIGC_APP_ID=<your-vivo-app-id>
VIVO_AIGC_BASE_URL=https://api-ai.vivo.com.cn/v1/chat/completions
VIVO_AIGC_API_KEY=<your-vivo-aigc-api-key>
VIVO_AIGC_MODEL=Volc-DeepSeek-V3.2

# Existing / fallback providers
GLM_API_KEY=<your-glm-api-key>
GLM_MODEL_NAME=<your-glm-model-name>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=<your-ollama-model-name>

# RAG settings
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=<embedding-provider>
RAG_EMBEDDING_MODEL=<embedding-model>
RAG_EMBEDDING_DIM=768
RAG_TOP_K=10
